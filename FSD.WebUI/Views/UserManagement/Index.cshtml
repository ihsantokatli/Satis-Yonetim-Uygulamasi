@model IEnumerable<FSD.Core.Entities.AppUser>

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

<div class="container mt-4">
    <h2>Kullanıcı Yönetimi</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <a asp-action="Create" class="btn btn-primary mb-3">Yeni Kullanıcı Ekle</a>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Kullanıcı Adı</th>
                <th>Ad Soyad</th>
                <th>E-posta</th>
                <th>Rol</th>
                <th>Durum</th>
                <th>Kayıt Tarihi</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr class="@(user.IsActive ? "" : "table-secondary")">
                    <td>@user.UserName</td>
                    <td>@user.FullName</td>
                    <td>@user.Email</td>
                    <td>
                        @if (user.UserType == FSD.Core.Entities.UserType.CompanyAdmin)
                        {
                            <span class="badge bg-warning text-dark">Admin</span>
                        }
                        else
                        {
                            <span class="badge bg-info">Kullanıcı</span>
                        }
                    </td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Pasif</span>
                        }
                    </td>
                    <td>@user.CreatedDate.ToString("dd.MM.yyyy")</td>
                    <td>
                        @if (user.IsActive)
                        {
                            <a asp-action="ToggleStatus" asp-route-id="@user.Id"
                               class="btn btn-warning btn-sm"
                               onclick="return confirm('@user.UserName kullanıcısını PASİF yapmak istediğinize emin misiniz?');">
                                Pasif Yap
                            </a>
                        }
                        else
                        {
                            <a asp-action="ToggleStatus" asp-route-id="@user.Id"
                               class="btn btn-success btn-sm"
                               onclick="return confirm('@user.UserName kullanıcısını AKTİF yapmak istediğinize emin misiniz?');">
                                Aktif Yap
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>