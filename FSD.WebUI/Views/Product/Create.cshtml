@model FSD.Core.Entities.Product

@{
    ViewData["Title"] = "Yeni Ürün Ekle";
}

<div class="container mt-4">
    <h2>Yeni Ürün Ekle</h2>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Ürün Adı</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Barcode" class="form-label">Barkod</label>
            <input asp-for="Barcode" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label">Kategori</label>
            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                <option value="">Kategori Seçin</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label">Fiyat</label>
            <input asp-for="Price" class="form-control" type="number" step="0.01" />
        </div>

        <div class="mb-3">
            <label asp-for="StockQuantity" class="form-label">Stok Adeti</label>
            <input asp-for="StockQuantity" class="form-control" type="number" />
        </div>

        <button type="submit" class="btn btn-success">Kaydet</button>
        <a asp-action="Index" class="btn btn-secondary">İptal</a>
    </form>
</div>