@model FSD.Core.Entities.Sale

@{
    ViewData["Title"] = "Satış Fişi";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-success text-white text-center">
                    <h4>✅ Satış Başarıyla Tamamlandı</h4>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>Fiş No:</strong> #@Model.Id
                        </div>
                        <div class="col-6 text-end">
                            <strong>Tarih:</strong> @Model.SaleDate.ToString("dd.MM.yyyy HH:mm")
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12">
                            <strong>Satışı Yapan:</strong> @Model.User?.FullName
                        </div>
                    </div>

                    <hr />

                    <table class="table table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Ürün</th>
                                <th class="text-center">Adet</th>
                                <th class="text-end">Birim Fiyat</th>
                                <th class="text-end">Tutar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.SaleDetails)
                            {
                                <tr>
                                    <td>@item.Product?.Name</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end">@item.UnitPrice.ToString("C")</td>
                                    <td class="text-end">@((item.UnitPrice * item.Quantity).ToString("C"))</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-group-divider">
                            <tr class="table-primary">
                                <td colspan="3" class="text-end"><strong>GENEL TOPLAM:</strong></td>
                                <td class="text-end"><strong>@Model.TotalAmount.ToString("C")</strong></td>
                            </tr>
                        </tfoot>
                    </table>

                    <div class="text-center mt-4">
                        <a href="/Sale/Index" class="btn btn-primary">Yeni Satış</a>
                        <a href="/Product/Index" class="btn btn-secondary">Ürün Listesi</a>
                        <button onclick="window.print()" class="btn btn-outline-dark">🖨️ Yazdır</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>